    "%lld windows on %@ will be saved as a workspace.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld window on %@ will be saved as a workspace."
