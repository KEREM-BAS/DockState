            "value": "Kayıtlı ekran bağlı"
          }
        }
      }
    },
    "These displays are connected now.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekranlar şu anda bağlı."
          }
        }
      }
    },
    "These displays match %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekranlar %@ ile eşleşiyor"
          }
        }
      }
    },
    "They work in every app and take priority over the app’s own shortcut.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her uygulamada çalışırlar ve uygulamanın kendi kısayolundan önce gelirler."
