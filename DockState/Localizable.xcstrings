            "state": "translated",
            "value": "Vazgeç"
          }
        }
      }
    },
    "Can’t restore": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yüklenemez"
          }
        }
      }
    },
    "Changes aren’t saved: the workspace file is from a newer DockState.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler kaydedilmedi: çalışma alanı dosyası daha yeni bir DockState sürümüne ait."
          }
        }
      }
    },
    "Connect these displays to see the status.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durumu görmek için bu ekranları bağlayın."
          }
        }
      }
    },
    "Convert for This Version": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Sürüme Dönüştür"
          }
        }
      }
    },
    "Copied": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalandı"
          }
        }
      }
    },
    "Copy Diagnostics": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanılama Bilgisini Kopyala"
          }
        }
      }
    },
    "Couldn’t change the login item: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş öğesi değiştirilemedi: %@"
          }
        }
      }
    },
    "Couldn’t open the app.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama açılamadı."
          }
        }
      }
    },
    "Couldn’t save workspaces to disk.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma alanları diske kaydedilemedi."
          }
        }
      }
    },
    "Couldn’t tell which %@ window this is": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun hangi %@ penceresi olduğu anlaşılamadı"
          }
        }
      }
    },
