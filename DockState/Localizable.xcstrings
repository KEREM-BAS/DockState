        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı ekranların tümü bağlı, ayrıca %lld ekran daha var"
          }
        }
      }
    },
    "Allow Accessibility access to save and restore.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetmek ve geri yüklemek için Erişilebilirlik erişimine izin verin."
          }
        }
      }
    },
    "Allow DockState to arrange your windows": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DockState’in pencerelerinizi düzenlemesine izin verin"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verildi"
          }
        }
      }
    },
    "Allow…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin Ver…"
          }
        }
      }
    },
    "Already in place · %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten yerinde · %lld"
          }
        }
      }
    },
    "Already turned on? After an update, macOS can keep the switch on for the old version. Select DockState in the list, remove it with –, then add it again with +.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten açık mı? Bir güncellemeden sonra macOS anahtarı eski sürüm için açık tutabilir. Listede DockState’i seçin, – ile kaldırın, ardından + ile yeniden ekleyin."
          }
        }
      }
    },
    "Already used by another app or by macOS. Choose another shortcut.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir uygulama veya macOS tarafından kullanılıyor. Başka bir kısayol seçin."
          }
        }
      }
    },
    "Always restore": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman geri yükle"
          }
        }
      }
    },
    "Always restore %@ when these displays connect": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekranlar bağlandığında %@ düzenini her zaman geri yükle"
          }
        }
      }
    },
    "Arrange your windows once and save them as a workspace.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencerelerinizi bir kez düzenleyin ve çalışma alanı olarak kaydedin."
          }
        }
      }
    },
    "Arrange your windows, then save the layout.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencerelerinizi düzenleyin, ardından yerleşimi kaydedin."
          }
        }
      }
    },
    "Arrange your windows, then save them.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencerelerinizi düzenleyin, ardından kaydedin."
          }
        }
      }
    },
    "Ask me": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bana sor"
          }
        }
      }
