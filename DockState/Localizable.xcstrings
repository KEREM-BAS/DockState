          "stringUnit": {
            "state": "translated",
            "value": "Çalışma Alanları"
          }
        }
      }
    },
    "Workspaces set to “Always restore” skip this.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Her zaman geri yükle” ayarlı çalışma alanları bunu atlar."
          }
        }
      }
    },
    "Workspaces were saved by a newer DockState": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma alanları daha yeni bir DockState ile kaydedilmiş"
          }
        }
      }
    },
    "You can rename or update it anytime.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğiniz zaman yeniden adlandırabilir veya güncelleyebilirsiniz."
          }
        }
      }
    },
    "You can undo any restore.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her geri yüklemeyi geri alabilirsiniz."
          }
        }
      }
    },
    "Your windows won’t be affected. You can undo right after deleting.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencereleriniz etkilenmez. Sildikten hemen sonra geri alabilirsiniz."
          }
        }
      }
    },
    "Your workspace, right where you left it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma alanınız, tam bıraktığınız yerde."
          }
        }
      }
    },
    "and %lld more": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ve %lld tane daha"
          }
        }
      }
    },
    "connected": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bağlı"
          }
        }
      }
    },
    "macOS asks you to approve any app that moves other apps’ windows. DockState uses this permission only to read and set window positions and sizes.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, başka uygulamaların pencerelerini taşıyan her uygulamayı onaylamanızı ister. DockState bu izni yalnızca pencere konumlarını ve boyutlarını okumak ve ayarlamak için kullanır."
          }
        }
      }
    },
    "not connected": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bağlı değil"
          }
        }
      }
    },
    "partly connected": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "kısmen bağlı"
          }
        }
