      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çalışma alanını sil"
          }
        }
      }
    },
    "Delete “%@”?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” silinsin mi?"
          }
        }
      }
    },
    "Deleted “%@”": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” silindi"
          }
        }
      }
    },
    "Display": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran"
          }
        }
      }
    },
    "Do nothing": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey yapma"
          }
        }
      }
    },
    "DockState can": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DockState şunları yapabilir"
          }
        }
      }
    },
    "DockState can arrange your windows now.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DockState artık pencerelerinizi düzenleyebilir."
          }
        }
      }
    },
    "DockState is open source.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DockState açık kaynaklıdır."
          }
        }
      }
    },
    "DockState loaded what it could and won’t change the file unless you convert it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DockState yükleyebildiği kadarını yükledi ve siz dönüştürmedikçe dosyayı değiştirmeyecek."
          }
        }
      }
    },
    "DockState loaded what it could and won’t change the file unless you convert it. A backup was kept at %@.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DockState yükleyebildiği kadarını yükledi ve siz dönüştürmedikçe dosyayı değiştirmeyecek. Bir yedek şurada saklandı: %@."
          }
        }
      }
    },
    "DockState needs Accessibility permission to see your windows.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DockState’in pencerelerinizi görebilmesi için Erişilebilirlik izni gerekiyor."
          }
        }
      }
    },
    "DockState needs permission": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DockState izin gerektiriyor"
          }
        }
      }
    },
    "DockState never": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DockState asla"
          }
        }
      }
    },
    "DockState remembers where your windows sit for each display setup. When you plug your displays back in, it puts everything back — only when you say so.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DockState, her ekran düzeninde pencerelerinizin nerede durduğunu hatırlar. Ekranlarınızı yeniden bağladığınızda her şeyi yerine koyar — yalnızca siz istediğinizde."
          }
        }
      }
    },
    "DockState shows a notification and waits for you.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DockState bir bildirim gösterir ve sizi bekler."
          }
        }
      }
    },
    "DockState stays quiet. Restore from the menu bar.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DockState sessiz kalır. Menü çubuğundan geri yükleyin."
          }
        }
      }
    },
    "DockState will quit and open again in the selected language.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DockState kapanıp seçilen dilde yeniden açılacak."
          }
        }
      }
    },
    "DockState, needs attention": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DockState, ilgi bekliyor"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti"
          }
        }
      }
    },
    "Each workspace can ask, restore automatically, or do nothing when its displays connect. Change this in Manage Workspaces.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her çalışma alanı, ekranları bağlandığında sorabilir, otomatik geri yükleyebilir ya da hiçbir şey yapmayabilir. Bunu Çalışma Alanlarını Yönet bölümünden değiştirin."
          }
        }
      }
    },
    "Every saved window is where you left it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen her pencere bıraktığınız yerde."
          }
        }
      }
    },
    "Everything was already in place.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey zaten yerindeydi."
          }
        }
      }
    },
    "Excluded": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hariç"
          }
        }
      }
    },
    "Fix…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzelt…"
          }
        }
      }
    },
    "Free and open source · MIT License": {
      "localizations": {
        "tr": {
