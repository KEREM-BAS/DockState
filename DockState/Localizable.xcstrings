        }
      }
    },
    "This display setup isn’t saved": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekran düzeni kayıtlı değil"
          }
        }
      }
    },
    "This is how your windows are arranged right now.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencereleriniz şu anda böyle düzenlenmiş."
          }
