    },
    "All saved displays are connected, plus %lld other": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "All saved displays are connected, plus %lld other"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "All saved displays are connected, plus %lld others"
