// Shared signing settings.
//
// Contributors: builds are signed "to run locally" by default, which needs no
// Apple account. Note that macOS ties the Accessibility permission to the code
// signature, so ad-hoc builds may need the permission re-granted after
// rebuilding. To sign with your own team, create Config/Signing.local.xcconfig
// (git-ignored) containing for example:
//
//     DEVELOPMENT_TEAM = ABCDE12345
//     CODE_SIGN_IDENTITY = Apple Development
//     CODE_SIGN_ENTITLEMENTS =
//
// Release builds are signed with Developer ID by CI (see docs/RELEASING.md).

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
// The hardened runtime is on for every build: notarization needs it, and it keeps other
// code (DYLD_INSERT_LIBRARIES) out of a process the user trusts with Accessibility. It only
// loads frameworks signed by the same team; ad-hoc builds have no team, so they may load
// Sparkle.framework through this entitlement. Builds signed with a team clear it.
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_ENTITLEMENTS = Config/AdHoc.entitlements

#include? "Signing.local.xcconfig"
